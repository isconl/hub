#!/usr/bin/env bash
# isconl/hub/cli/bin/isconl
# Hub entry point — combined dashboard sourcing scope, space, spark.
# ─────────────────────────────────────────────────────────────────────────────
# CHANGELOG (newest first)
# ─────────────────────────────────────────────────────────────────────────────
#   v2.3.0  2026-04-30  Standalone hub repo. Shared libs from
#                       ~/.local/lib/sconl/. All system data from tenant.toml.
#                       Python engines from calendar-core.
#   v2.2.1  2026-04-20  Renamed from sconlx → isconl; iscope/ispace/ispark
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

# ─────────────────────────────────────────────────────────────────────────────
# PATH RESOLUTION
# hub/cli/bin/ → hub/cli/ → hub/ (repo root)
# ─────────────────────────────────────────────────────────────────────────────
_HUB_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_HUB_ROOT="$(cd "$_HUB_BIN/../.." && pwd)"             # hub repo root
_HUB_CLI_LIB="$_HUB_ROOT/cli/lib"                      # cross.sh, ai.sh
_SHARED_LIB="${HOME}/.local/lib/sconl"                  # ui.sh, db.sh, events.sh
_ISCONL_ROOT="$(cd "$_HUB_ROOT/.." && pwd)"            # parent: iSconl/

# ─────────────────────────────────────────────────────────────────────────────
# SHARED LIB CHECK
# ─────────────────────────────────────────────────────────────────────────────
if [[ ! -f "$_SHARED_LIB/ui.sh" ]]; then
  printf '  x  Shared libs not found at %s\n' "$_SHARED_LIB" >&2
  printf '     Run: %s/hub/install.sh\n' "$_ISCONL_ROOT" >&2
  exit 1
fi

# ─────────────────────────────────────────────────────────────────────────────
# TENANT CONFIG — single source of truth for all data paths
# ─────────────────────────────────────────────────────────────────────────────
_TENANT_TOML="${HOME}/.config/sconl/tenant.toml"

_read_toml_value() {
  local file="$1" key="$2"
  grep -E "^${key}\s*=" "$file" 2>/dev/null \
    | head -1 \
    | sed 's/.*=\s*"\(.*\)"/\1/'
}

if [[ -f "$_TENANT_TOML" ]]; then
  _SCOPE_DATA_DIR="$(_read_toml_value "$_TENANT_TOML" "scope_dir")"
  _SPACE_DATA_DIR="$(_read_toml_value "$_TENANT_TOML" "space_dir")"
  _SPARK_DATA_DIR="$(_read_toml_value "$_TENANT_TOML" "spark_dir")"
  _SHARED_LIB_DIR="$(_read_toml_value "$_TENANT_TOML" "shared_lib_dir")"
  _CALENDARX_DIR="$(_read_toml_value  "$_TENANT_TOML" "calendarx_dir")"
  [[ -n "$_SHARED_LIB_DIR" ]] && _SHARED_LIB="$_SHARED_LIB_DIR"
  [[ -n "$_CALENDARX_DIR"  ]] && _CALX_CORE="$_CALENDARX_DIR/core/sconl_calendar"
else
  printf '  !  tenant.toml not found at %s\n' "$_TENANT_TOML" >&2
  printf '     Run: hub/install.sh  to set up your tenant config\n' >&2
fi

# Fallbacks — resolve relative to iSconl/ parent
[[ -z "${_SCOPE_DATA_DIR:-}" ]] && _SCOPE_DATA_DIR="$_ISCONL_ROOT/scope/data"
[[ -z "${_SPACE_DATA_DIR:-}" ]] && _SPACE_DATA_DIR="$_ISCONL_ROOT/space/data"
[[ -z "${_SPARK_DATA_DIR:-}" ]] && _SPARK_DATA_DIR="$_ISCONL_ROOT/spark/data"

# calendar-core fallback — sibling of iSconl in Systems/
if [[ -z "${_CALX_CORE:-}" ]]; then
  _CALX_CORE="$(cd "$_ISCONL_ROOT/../XCore/calendar-core/core/sconl_calendar" 2>/dev/null && pwd)" || \
  _CALX_CORE=""
fi

# ─────────────────────────────────────────────────────────────────────────────
# PYTHON ENGINE PATH RESOLUTION
# ─────────────────────────────────────────────────────────────────────────────
_py_path() {
  local canonical="$1" legacy="$2" label="$3"
  if [[ -f "$canonical" ]]; then
    printf '%s' "$canonical"; return 0
  fi
  if [[ -f "$legacy" ]]; then
    printf '  !  %s found at legacy path — move to calendar-core\n' "$label" >&2
    printf '     mv "%s" "%s"\n' "$legacy" "$canonical" >&2
    printf '%s' "$legacy"; return 0
  fi
  printf '  x  %s not found\n' "$label" >&2
  printf '%s' "$canonical"; return 1
}

_LEGACY_LIB="$(cd "$_ISCONL_ROOT/../XCore/xspace/isconl-space/lib" 2>/dev/null && pwd)" || \
  _LEGACY_LIB=""

_EQUICYCLE_PY="$(_py_path \
  "${_CALX_CORE:-}/equicycle.py" \
  "${_LEGACY_LIB:-}/equicycle.py" \
  "equicycle.py")" || true

_CAL_PY="$(_py_path \
  "${_CALX_CORE:-}/calendar_data.py" \
  "${_LEGACY_LIB:-}/calendar_data.py" \
  "calendar_data.py")" || true

export _EQUICYCLE_PY _CAL_PY

# ─────────────────────────────────────────────────────────────────────────────
# EXPORT ALL PATHS FOR SOURCED LIBS
# Libs use ${_VAR:-fallback} so these are authoritative and never overwritten.
# Hub is the only binary that needs all three system data dirs.
# ─────────────────────────────────────────────────────────────────────────────

# Primary flat dir — hub treats scope as the primary system
export _FLAT_DIR="${HOME}/.local/share/sconl/data"

# Per-system dirs (used by cross.sh to read from all three)
export _FLAT_SCOPE_DIR="$_SCOPE_DATA_DIR"
export _FLAT_SPACE_DIR="$_SPACE_DATA_DIR"
export _FLAT_SPARK_DIR="$_SPARK_DATA_DIR"

# Standard path vars (legacy compat — sourced libs check these)
export _FLAT_SCOPE_INBOX="$_SCOPE_DATA_DIR/inbox.tsv"
export _FLAT_SCOPE_TASKS="$_SCOPE_DATA_DIR/tasks.tsv"
export _FLAT_SCOPE_GOALS="$_SCOPE_DATA_DIR/goals.tsv"
export _FLAT_SCOPE_PROJECTS="$_SCOPE_DATA_DIR/projects.tsv"
export _FLAT_SCOPE_CYCLES="$_SCOPE_DATA_DIR/cycles.tsv"
export _FLAT_SCOPE_REFLECTIONS_TSV="$_SCOPE_DATA_DIR/reflections.tsv"
export _FLAT_SCOPE_REFLECTIONS_DIR="$_SCOPE_DATA_DIR/reflections"
export _FLAT_SCOPE_IDENTITY="$_SCOPE_DATA_DIR/identity.sh"

export _FLAT_SPACE_SPACES="$_SPACE_DATA_DIR/spaces.tsv"
export _FLAT_SPACE_PROJECTS="$_SPACE_DATA_DIR/projects.tsv"
export _FLAT_SPACE_CONTACTS="$_SPACE_DATA_DIR/contacts.tsv"
export _FLAT_SPACE_KPI_DEFS="$_SPACE_DATA_DIR/kpi_defs.tsv"
export _FLAT_SPACE_KPI_LOG="$_SPACE_DATA_DIR/kpi_log.tsv"
export _FLAT_SPACE_EVENTS="$_SPACE_DATA_DIR/events.tsv"

export _FLAT_SPARK_IDEAS="$_SPARK_DATA_DIR/ideas.tsv"
export _FLAT_SPARK_LEARNING="$_SPARK_DATA_DIR/learning.tsv"
export _FLAT_SPARK_DIA="$_SPARK_DATA_DIR/dia.tsv"
export _FLAT_JOURNAL_DIR="$_SPARK_DATA_DIR/journal"
export _FLAT_NOTES_DIR="$_SPARK_DATA_DIR/notes"

# Calendar data (read from scope data dir — calendar.json is personal config)
export _FLAT_EVENTS="$_HUB_ROOT/core/events.tsv"
export _CAL_DATA_FILE="${HOME}/.local/share/sconl/calendar.json"
[[ ! -f "$_CAL_DATA_FILE" ]] && \
  _CAL_DATA_FILE="$(ls "$_SCOPE_DATA_DIR/../calendar.json" 2>/dev/null || true)"

# Lib dir pointers (legacy compat)
export _ISCONLSPACE_LIB_DIR="$_HUB_CLI_LIB"
export _ISCONLSPACE_DATA_DIR="$_SCOPE_DATA_DIR"
export _ISCONLSPACE_DIR="$_HUB_ROOT"

IFS=$'\n\t'

# ─────────────────────────────────────────────────────────────────────────────
# SOURCE ALL LIBS — shared → scope → space → spark → hub integration
# ─────────────────────────────────────────────────────────────────────────────
source "$_SHARED_LIB/ui.sh"
source "$_SHARED_LIB/db.sh"
source "$_SHARED_LIB/events.sh"
source "$_ISCONL_ROOT/scope/cli/lib/scope.sh"
source "$_ISCONL_ROOT/scope/cli/lib/calendar.sh"
source "$_ISCONL_ROOT/space/cli/lib/space.sh"
source "$_ISCONL_ROOT/spark/cli/lib/spark.sh"
source "$_HUB_CLI_LIB/cross.sh"
source "$_HUB_CLI_LIB/ai.sh"

# ─────────────────────────────────────────────────────────────────────────────
# LOAD DYNAMIC INTEGRATIONS (calendarx, financex — if installed)
# ─────────────────────────────────────────────────────────────────────────────
_INTEGRATIONS_DIR="$_HUB_ROOT/integrations"
if [[ -d "$_INTEGRATIONS_DIR" ]]; then
  command -v calendarx &>/dev/null && \
    [[ -f "$_INTEGRATIONS_DIR/calendarx.sh" ]] && \
    source "$_INTEGRATIONS_DIR/calendarx.sh" 2>/dev/null || true

  command -v financex &>/dev/null && \
    [[ -f "$_INTEGRATIONS_DIR/financex.sh" ]] && \
    source "$_INTEGRATIONS_DIR/financex.sh" 2>/dev/null || true
fi

# ─────────────────────────────────────────────────────────────────────────────
# INIT
# ─────────────────────────────────────────────────────────────────────────────
_db_init

# ─────────────────────────────────────────────────────────────────────────────
# BASENAME DISPATCH
# Supports: isconl (full hub), iscope, ispace, ispark, sconl (public alias)
# ─────────────────────────────────────────────────────────────────────────────
_INVOKED_AS="$(basename "$0")"
case "$_INVOKED_AS" in
  iscope)  set -- scope  "$@" ;;
  ispace)  set -- space  "$@" ;;
  ispark)  set -- spark  "$@" ;;
  sconl)   : ;;  # route normally as hub
  sconlx)  : ;;  # legacy alias — full compat
esac

# ─────────────────────────────────────────────────────────────────────────────
# VERSION / STATUS FLAGS
# ─────────────────────────────────────────────────────────────────────────────
case "${1:-}" in
  --version|-v)
    printf 'isconl 2.3.0 (%s mode)\n' "$_DATA_MODE"
    printf 'data: %s\n' "$_SCOPE_DATA_DIR"
    exit 0 ;;
  --status)
    _cross_status; exit 0 ;;
  --help|-h)
    printf 'Usage: isconl [scope|space|spark|cal|x|--version|--status]\n'
    printf '       iscope / ispace / ispark — system shortcuts\n'
    exit 0 ;;
esac

# ─────────────────────────────────────────────────────────────────────────────
# MAIN ROUTER
# ─────────────────────────────────────────────────────────────────────────────
_cmd="${1:-}"
shift || true

case "$_cmd" in
  ""|x|dashboard)         _cross_route "${@}" ;;
  scope|s)                _scope_route "${@}" ;;
  space|sp)               _space_route "${@}" ;;
  spark|k)                _spark_route "${@}" ;;
  cal|calendar)           _cal_route   "${@}" ;;
  task)                   _scope_route task "${@}" ;;
  journal)                _spark_route journal "${@}" ;;
  note)                   _spark_route note "${@}" ;;
  plan)                   _scope_route plan "${@}" ;;
  agent)
    printf '  isconl agent — coming soon\n' >&2 ;;
  *)
    printf '  x  Unknown command: %s\n' "$_cmd" >&2
    printf '     isconl --help\n' >&2
    exit 1 ;;
esac
