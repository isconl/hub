# Copy to .env and fill in before `docker compose up -d`. Never commit the
# real .env -- it's already in .gitignore.

# One static bearer token per engine (or reuse ISCONL_TOKEN everywhere --
# each engine falls back to it). These gate who may call the engine
# directly; hub's own token gates who may call hub.
VAULT_TOKEN=
PULSE_TOKEN=
SCOPE_TOKEN=
CIRCLE_TOKEN=
SPARK_TOKEN=
HUB_TOKEN=

# Bitwarden Secrets Manager -- every engine pulls its own secrets from here
# at boot (see lib/secrets.js). Same credentials for all six containers.
BWS_ACCESS_TOKEN=
BWS_ORGANIZATION_ID=

# scope's Jira integration (optional -- scope degrades gracefully without it)
JIRA_HOST=
JIRA_EMAIL=
JIRA_PROJECT=

# hub's Render "update power" (optional -- redeploy endpoints degrade
# gracefully without it)
RENDER_API_KEY=

# The legacy monolith (Sconl/isconl-agent) -- the /api/* compat layer for
# the already-installed Flutter app proxies here for anything a new engine
# doesn't serve yet (see lib/api-compat.js). Optional: without it, those
# routes report a clean 502 instead of working.
LEGACY_API_URL=
LEGACY_TOKEN=
