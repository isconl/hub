# Copy to .env and fill in before `docker compose up -d`. Never commit the
# real .env -- it's already in .gitignore.
#
# THE ONLY REQUIRED VALUES ARE THE FOUR BITWARDEN ONES BELOW. Every engine
# pulls its own auth token, Jira config, Render key, etc. from Bitwarden
# Secrets Manager at boot (see each repo's lib/secrets.js) -- a fresh clone
# on a new machine needs nothing else to have a working fleet on localhost.

# Bitwarden Secrets Manager -- the one bootstrap credential everything else
# resolves from. Same four values for all six containers.
BWS_ACCESS_TOKEN=
BWS_ORGANIZATION_ID=
# Region matters: an org on the EU cloud (vault.bitwarden.eu) fails silently
# with "invalid_client" against the US default if these are left blank --
# this was a real, previously-invisible bug in every container. Leave blank
# only if your org is genuinely on the US cloud.
BWS_API_URL=https://api.bitwarden.eu
BWS_IDENTITY_URL=https://identity.bitwarden.eu

# ── Everything below is optional ──────────────────────────────────────────
# Each engine falls back to the matching Bitwarden secret (VAULT_TOKEN,
# PULSE_TOKEN, SCOPE_TOKEN, CIRCLE_TOKEN, SPARK_TOKEN, HUB_TOKEN) when these
# are left blank, so a fresh clone works without setting any of them.
# Override here only to use a different token than the one in Bitwarden
# (e.g. a throwaway value for local-only testing).
VAULT_TOKEN=
PULSE_TOKEN=
SCOPE_TOKEN=
CIRCLE_TOKEN=
SPARK_TOKEN=
HUB_TOKEN=

# scope's Jira integration (optional -- scope degrades gracefully without it;
# falls back to Bitwarden's JIRA_HOST/JIRA_EMAIL/JIRA_PROJECT if unset)
JIRA_HOST=
JIRA_EMAIL=
JIRA_PROJECT=

# hub's Render "update power" (optional -- falls back to Bitwarden's
# RENDER_API_KEY; redeploy endpoints degrade gracefully without either)
RENDER_API_KEY=

# The legacy monolith (Sconl/isconl-agent) -- the /api/* compat layer for
# the already-installed Flutter app proxies here for anything a new engine
# doesn't serve yet (see lib/api-compat.js). Optional: without it, those
# routes report a clean 502 instead of working.
LEGACY_API_URL=
LEGACY_TOKEN=
